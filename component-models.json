        "component": "text",
        "valueType": "string",
        "name": "mediaAlt",
        "label": "Media Alt Text",
        "value": ""
      },
      {
        "component": "text",
        "valueType": "string",
        "name": "ctaText",
        "label": "CTA Text",
        "value": " ",
        "description": "CTA link displayed below the hero text"
      },
      {
        "component": "boolean",
        "valueType": "boolean",
        "name": "isVideoCta",
        "label": "Is Video CTA",
        "value": false,
        "description": "If true, clicking on the CTA will open a video modal",
        "condition": {
          "!==": [
            {
              "var": "ctaText"
            },
            " "
          ]
        }
      },
      {
        "component": "reference",
        "valueType": "string",
        "name": "video",
        "label": "Video",
        "value": "",
        "description": "Video for the video modal",
        "condition": {
          "and": [
            {
              "!==": [
                {
                  "var": "ctaText"
                },
                " "
              ]
            },
            {
              "===": [
                {
                  "var": "isVideoCta"
                },
                true
              ]
            }
          ]
        }
      },
      {
        "component": "text",
        "valueType": "string",
        "name": "ctaUrl",
        "label": "CTA Url",
        "value": " ",
        "required": true,
        "condition": {
          "and": [
            {
              "!==": [
                {
                  "var": "ctaText"
                },
                " "
              ]
            },
            {
              "===": [
                {
                  "var": "isVideoCta"
                },
                false
              ]
            }
          ]
        }
      }
    ]
  },
