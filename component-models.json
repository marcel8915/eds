      },
      {
        "component": "boolean",
        "valueType": "boolean",
        "name": "isSlideInText",
        "label": "Is Slide In Text",
        "value": false,
        "description": "If true, the hero text will slide in from the left and right"
      },
      {
        "component": "reference",
        "valueType": "string",
        "name": "media",
        "label": "Media",
        "multi": false,
        "required": true
      },
